{
    "name": "olivercullimore/php-ecommerce-store",
    "description": "Shop Manager: stock, BOM, purchasing, sales, invoicing and a public storefront.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "doctrine/dbal": "^4.2",
        "twig/twig": "^3.14",
        "dompdf/dompdf": "^3.0",
        "monolog/monolog": "^3.8",
        "vlucas/phpdotenv": "^5.6",
        "robmorgan/phinx": "^0.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": { "psr-4": { "App\\": "src/" } },
    "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": ["@cs", "@stan", "@test"]
    },
    "config": { "sort-packages": true, "optimize-autoloader": true }
}

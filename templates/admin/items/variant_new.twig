{% extends 'admin/layout.twig' %}
{% block body %}
<h1>New variant of {{ item.name }}</h1>
<form method="post" action="/admin/items/{{ item.id }}/variants" class="card">{{ csrf_field() }}
<div class="row">
<div><label>SKU</label><input name="sku" required></div>
<div><label>Variant name (e.g. Silk Red 1.75mm)</label><input name="name" required></div>
<div><label>Unit</label><input name="unit" value="each" size="8"></div>
<div><label>Reorder threshold</label><input name="reorder_threshold" type="number" step="any" min="0" value="0" size="8"></div>
</div>
<label><input type="checkbox" name="sellable" value="1"> Sellable on the storefront</label>
<label>Sale price (GBP)</label><input name="sale_price" type="number" step="0.01" min="0">
<label>Notes</label><textarea name="notes" rows="2" style="width:100%"></textarea>
<p><button>Create variant</button></p></form>
{% endblock %}

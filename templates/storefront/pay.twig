{% extends 'storefront/single.twig' %}
{% block title %}Payment{% endblock %}
{% block content %}
<h1>Payment</h1>
<p class="mut">Order {{ order_id }}. Your card details go straight to our payment provider.</p>
<form id="pay" method="post" action="{{ initiation.actionUrl }}" target="payframe">
{% for k, v in initiation.fields %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endfor %}
<noscript><button>Pay now</button></noscript></form>
<iframe name="payframe" title="Secure payment" style="width:100%;height:560px;border:1px solid var(--line);border-radius:8px;background:#fff"></iframe>
<script>document.getElementById('pay').submit();</script>
{% endblock %}

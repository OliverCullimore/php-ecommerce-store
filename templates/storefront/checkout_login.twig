{% extends 'storefront/single.twig' %}
{% block title %}Sign in to continue{% endblock %}
{% block content %}
<h1>Welcome back</h1>
<p>There's an account for <strong>{{ email }}</strong>. Sign in to reuse your details, or carry on as a guest.</p>
<form method="post" action="/checkout/login">{{ csrf_field() }}<label>Password</label><input type="password" name="password" required autofocus style="width:100%"><p><button>Sign in</button></p></form>
<form method="post" action="/checkout/email">{{ csrf_field() }}<input type="hidden" name="email" value="{{ email }}"><input type="hidden" name="guest" value="1"><button class="sec">Continue as guest</button></form>
{% endblock %}

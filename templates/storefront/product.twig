{% extends 'storefront/layout.twig' %}
{% block title %}{{ item.name }}{% endblock %}
{% block body %}
<h1>{{ item.name }}</h1>
<p style="white-space:pre-line">{{ item.description }}</p>
<form method="post" action="/cart/add" class="tile" style="max-width:420px">{{ csrf_field() }}
<label>Option</label>
<select name="variant_id" required>
{% for v in variants %}<option value="{{ v.id }}">{{ v.name }}{% for k, val in v.options %} · {{ k }}: {{ val }}{% endfor %} — {{ v.sale_price|gbp }}</option>{% endfor %}
</select>
<label>Quantity</label><input name="quantity" type="number" min="1" max="99" value="1" style="width:5rem">
<p><button>Add to basket</button></p></form>
{% endblock %}
